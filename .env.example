# База: строка подключения Neon или Railway Postgres. Без неё локально используется Postgres в памяти.
DATABASE_URL=
# Публичный адрес Railway (*.proxy.rlwy.net) отдаёт самоподписанный сертификат. Нужен только там:
# DATABASE_SSL=no-verify

# Ключ шифрования API-ключей, 32 байта base64. Обязателен в продакшене, при потере ключи придётся ввести заново.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Адрес сайта, например https://app.example.com
APP_URL=

# Секрет фоновых задач для Vercel Cron, не короче 24 символов
CRON_SECRET=

# true — показать вход в демо без регистрации (в продакшене по умолчанию выключен)
# DEMO_ENABLED=true
